# Скопируйте в .env и заполните. Файл .env в git не коммитьте.
# Telegram: создайте бота у @BotFather командой /newbot, токен вставьте сюда.
LINQ_TG_TOKEN=
# VK: сообщество -> Управление -> Работа с API -> ключ доступа (права: сообщения, фотографии).
LINQ_VK_TOKEN=
LINQ_VK_GROUP_ID=
# Адрес панели, доступный получателям (необязательно): появится кнопка «Открыть в панели».
LINQ_PUBLIC_URL=
