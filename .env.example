# Режим инференса: LINQ_TPU или ONNX_CPU
INFERENCE_BACKEND=ONNX_CPU

# Пути к моделям
ONNX_MODEL_PATH=models/onnx/safety_yolov8.onnx
TPU_MODEL_PATH=models/tpu/safety_yolov8_h1m.tpu
LINQ_ADAPTER_MODULE=linq_adapter
LINQ_INPUT_NAME=images
LINQ_OUTPUT_NAME=output0
LINQ_DEVICE_INDEX=0
CV_API_URL=http://127.0.0.1:8000/api/v1

# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/linq_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linq_safety

# Хранилище стоп-кадров инцидентов: local или s3
STORAGE_TYPE=local
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=linq-safety-snapshots
S3_REGION_NAME=ru-central1
S3_PUBLIC_URL_PREFIX=

# Параметры детекции и правил ТБ
CONFIDENCE_THRESHOLD=0.15
IOU_THRESHOLD=0.45
DEBOUNCE_FRAMES=15
COOLDOWN_SECONDS=300
