# Режим инференса: LINQ_TPU или ONNX_CPU
INFERENCE_BACKEND=ONNX_CPU

# Пути к моделям
ONNX_MODEL_PATH=models/onnx/yolov8n_safety_640.onnx
TPU_MODEL_PATH=models/tpu/yolov8n_b1_o1_h1m.tpu

# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных
DATABASE_URL=sqlite:///./storage/db.sqlite3

# Параметры детекции и правил ТБ
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
DEBOUNCE_FRAMES=15
COOLDOWN_SECONDS=300
