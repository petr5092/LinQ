# =====================================================================
# LinQ Safety Guard Environment Configuration (Example)
# =====================================================================

# Режим инференса: LINQ_TPU или ONNX_CPU
INFERENCE_BACKEND=ONNX_CPU
ONNX_MODEL_PATH=models/onnx/safety_yolov8n.onnx
TPU_MODEL_PATH=models/tpu/yolov8n_b1_o1_h1m.tpu

# Онлайн-камера: Xiaomi Home Security Camera 360° 3 Pro (MJSXJ16CM)
CAMERA_SOURCE=rtsp://127.0.0.1:8554/xiaomi_cam
CAMERA_NAME=Xiaomi Smart Camera 3 Pro (MJSXJ16CM)
# Демо-видео:
# CAMERA_SOURCE=storage/demo_videos/construction_safety.mp4

# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/linq_safety
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linq_safety

# Хранилище стоп-кадров инцидентов: local или s3
STORAGE_TYPE=local
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=linq-safety-snapshots
S3_REGION_NAME=ru-central1
S3_PUBLIC_URL_PREFIX=

# Параметры детекции и правил ТБ
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
DEBOUNCE_FRAMES=15
COOLDOWN_SECONDS=300
